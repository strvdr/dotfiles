#!/usr/bin/env bash
# Block commits that contain secret-shaped content.
#
# Exists because the configs in this repo are symlinked from their live
# locations, so `git add -A` picks up whatever an application wrote into them
# — a credential can end up staged without anyone deciding to include it.
#
# Bypass for a known false positive:  git commit --no-verify
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
report() {
  [ "$fail" -eq 0 ] && printf '\n\033[1;31mpre-commit: possible secret in staged changes\033[0m\n\n'
  fail=1
  printf '  \033[1m%s\033[0m\n    %s\n\n' "$1" "$2"
}

# ── 1. Filenames that should never be committed ──────────────────────
while IFS= read -r f; do
  case "$(basename "$f")" in
    id_rsa|id_dsa|id_ecdsa|id_ed25519|*.pem|*.pfx|*.p12|.env|.env.*|*.kdbx|credentials|.netrc|.pgpass)
      report "$f" "filename indicates private key material or credentials"
      ;;
  esac
done <<< "$staged"

# ── 2. High-confidence content patterns ──────────────────────────────
# Unambiguous: private key blocks and provider-prefixed tokens. These do not
# appear in legitimate config, so any hit is treated as real.
high='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|glpat-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}'

while IFS= read -r f; do
  [ -f "$f" ] || continue
  # -e is required: the BEGIN-PRIVATE-KEY pattern starts with dashes and would
  # otherwise be parsed as grep options.
  if hit=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -EIno -e "$high" | head -1); then
    [ -n "$hit" ] && report "$f" "matches a known credential format: ${hit#*:}"
  fi
done <<< "$staged"

# ── 3. Lower-confidence: assignments with a real-looking value ───────
# Deliberately narrow — requires an assignment operator and a value of at least
# 12 chars, so prose like "# password manager" and empty defaults don't trip it.
generic='(api[_-]?key|secret|token|passwd|password|access[_-]?key|auth[_-]?token|client[_-]?secret)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9/+_-]{12,}'

while IFS= read -r f; do
  [ -f "$f" ] || continue
  if hit=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -EIion -e "$generic" | head -1); then
    [ -n "$hit" ] && report "$f" "assignment with a credential-like value: ${hit#*:}"
  fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
  cat <<'MSG'
Nothing was committed. Either remove the value, or if this is a false
positive, re-run with:

    git commit --no-verify

MSG
  exit 1
fi

exit 0
